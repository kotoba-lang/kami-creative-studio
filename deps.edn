{:paths ["src/main" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        kotoba-lang/kisekae {:local/root "../kisekae"}
        kotoba-lang/kami-eizo-timeline {:local/root "../kami-eizo-timeline"}
        kotoba-lang/kami-ongaku-project {:local/root "../kami-ongaku-project"}
        kotoba-lang/douga {:local/root "../douga"}}
 :aliases
 {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      reagent/reagent {:mvn/version "1.2.0"}
                      com.thheller/shadow-css {:mvn/version "0.6.1"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :pages {:extra-paths ["src/dev"]
          :extra-deps {com.thheller/shadow-css {:mvn/version "0.6.1"}
                       org.clojure/data.json {:mvn/version "2.5.1"}
                       hiccup/hiccup {:mvn/version "2.0.0-RC4"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :e2e {:extra-paths ["test-e2e"]
        :extra-deps {io.github.cognitect-labs/test-runner
                     {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
        :main-opts ["-m" "cognitect.test-runner" "-d" "test-e2e"]}}}
